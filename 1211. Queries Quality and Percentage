
1211. Queries Quality and Percentage

# Write your MySQL query statement below
select query_name , 
ROUND(AVG(rating/position), 2) as quality,
ROUND((select count(rating) from Queries q where rating<3 and q.query_name=qq.query_name)*100/count(rating),2) as poor_query_percentage 
from Queries qq
group by query_name;
